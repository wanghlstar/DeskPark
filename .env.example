# 复制为 .env 后按需修改：cp .env.example .env

# 对外端口（不用 HTTPS 时，用 http://服务器IP:端口 访问）
HTTP_PORT=8787
# 监听地址：启用 HTTPS 叠加配置时建议改为 127.0.0.1，只让 Caddy 访问
HTTP_BIND=0.0.0.0

# 联机时每一步的思考时限（毫秒），超时由电脑代打
TURN_TIMEOUT_MS=30000

# AI 人机的接口转发（解决浏览器跨域），设为 off 关闭
AI_PROXY=
# 允许转发的本地 AI 完整基址，多个用逗号分隔；留空仅允许 HTTPS 公网接口
# 例如：http://192.168.2.8:19020/v1
AI_PROXY_ALLOWED_TARGETS=

# 服务器默认 AI（可选）：填写地址和模型后，玩家可直接选择「服务器默认」
# 协议：openai 或 anthropic；Key 留在服务器，不下发给浏览器
AI_DEFAULT_PROTOCOL=openai
AI_DEFAULT_BASE_URL=
AI_DEFAULT_API_KEY=
AI_DEFAULT_MODEL=

# 部署在反向代理（Caddy / Nginx）之后时设为 1，按 X-Forwarded-For 识别真实 IP（HTTPS 叠加配置已自动设置）
TRUST_PROXY=
# 每个 IP 同时的联机连接数上限
MAX_CONN_PER_IP=20

# 使用的镜像（可固定到某个版本，例如 ghcr.io/wanghlstar/deskpark:0.3.0）
DESKPARK_IMAGE=ghcr.io/wanghlstar/deskpark:latest

# 本机构建时使用的 npm 镜像源（国内建议 https://registry.npmmirror.com）
NPM_REGISTRY=

# 启用 HTTPS 时填写你的域名，例如 game.example.com
DOMAIN=
